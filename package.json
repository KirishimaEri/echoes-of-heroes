{
  "name": "echoes-of-heroes",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "山河同名 (Echoes of Heroes) — an open, sourced atlas of Chinese places named after martyrs of the War of Resistance Against Japan, 1931–1945. A static Next.js site plus the 294-entry dataset behind it.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/epochs.test.mts scripts/view_model.test.mts",
    "validate:data": "node scripts/validate_data.js",
    "data:merge": "node scripts/merge_places.js",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:data",
    "verify:export": "node scripts/check_export.js"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "framer-motion": "^14.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
