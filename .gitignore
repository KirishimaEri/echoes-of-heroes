# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# leftover README export bundle (duplicate of README.md + a second copy of
# hero-banner.png). Kept on disk, but out of history — committing it would bake
# ~440 KB of duplicate binary into every clone. Delete the directory if you no
# longer need it; nothing in the build references it.
/shanheshongming-readme-bundle/

# Internal review records. Keep on disk for future iterations, but never
# commit — they contain unverified judgments and must not enter public history.
/AUDIT-REPORT.md
/AUDIT-REPORT-2.md

# AI-era internal review documents (never publish)
/AUDIT-REPORT.md
/AUDIT-REPORT-2.md
/DESIGN-AUDIT.md
/AI-FLAVOR-AUDIT.md

# UI review screenshots (intermediate, regenerated on demand)
/.uishots/

# Local scratch: endpoint probes, one-off response dumps, and the HEAD snapshot
# used to semantically diff places.json before committing. Nothing in the build
# references them.
/.tmp/

# Static export bundles handed out as release attachments. Committing them would
# bake ~800 KB of regenerable binary into every clone — run `npm run build` and
# zip out/, or attach the archive to a GitHub Release.
/echoes-of-heroes-v*-static.zip

# Geocoding run caches: resumable and regenerable by re-running the resolvers.
# The provenance that matters per record — source, date, which administration it
# was verified against — already lives in coordinate_source / coordinate_note.
/scripts/data/geocode_cache.json
/scripts/data/geocode_web_cache.json

# The expansion's regional shards and deduped output are superseded by
# scripts/data/sector*.json (the archive's source of truth). Keep in history only
# the curation report and the script that records its inclusion and dedupe rules.
/data-expansion/new-places.json
/data-expansion/partial-*.json
